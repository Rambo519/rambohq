# Full URL to the serverless market proxy (required for Market Watch).
# Deploy `api/markets.js` on Vercel, then set this to e.g.:
#   https://your-project.vercel.app/api/markets
# For local dev with `vercel dev` (default http://localhost:3000):
#   http://localhost:3000/api/markets
VITE_MARKETS_API_URL=
